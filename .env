# Eventuate image versions — mapped from gradle.properties
# eventuateCommonImageVersion
EVENTUATE_COMMON_VERSION=0.15.0.RELEASE

# eventuateMessagingKafkaImageVersion
EVENTUATE_MESSAGING_KAFKA_IMAGE_VERSION=0.15.0.RELEASE

# eventuateCdcImageVersion
EVENTUATE_CDC_VERSION=0.13.0.RELEASE

# eventuateTramSagasImageVersion (used by MySQL schema init)
EVENTUATE_SAGA_VERSION=0.19.0.RELEASE

# eventuateExamplesBaseImageVersion (base image for service builds)
EVENTUATE_JAVA_BASE_IMAGE_VERSION=java21

# Host IP advertised to Kafka clients running outside Docker
DOCKER_HOST_IP=localhost
